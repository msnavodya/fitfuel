# Copy this to .env and fill values
# Client / Expo
EXPO_CLIENT_ID=your_expo_client_id
IOS_CLIENT_ID=your_ios_client_id
ANDROID_CLIENT_ID=your_android_client_id
WEB_CLIENT_ID=your_web_client_id
SERVER_URL=http://localhost:4242

# Firebase (web config fields)
FIREBASE_API_KEY=REPLACE
FIREBASE_AUTH_DOMAIN=REPLACE
FIREBASE_PROJECT_ID=REPLACE
FIREBASE_STORAGE_BUCKET=REPLACE
FIREBASE_MESSAGING_SENDER_ID=REPLACE
FIREBASE_APP_ID=REPLACE
